pipeline{
    agent any
    stages{
        stage('Build'){
            steps{
                sh """
                echo "hello,this is build
                """
            }
        }
        stage('Test'){
            steps{
                sh """
                echo "hello,this is Test
                """
            }
        }
         stage('Deploy'){
            steps{
                sh """
                echo "hello,this is deploy
                """
            }
        }
        

    }

}